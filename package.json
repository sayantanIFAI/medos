{
  "name": "medos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:migrate": "pnpm --filter @medos/database migrate",
    "db:seed": "pnpm --filter @medos/database seed",
    "licenses:audit": "node scripts/license-audit.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
