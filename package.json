{
    "name":  "medos",
    "private":  true,
    "version":  "0.1.0",
    "packageManager":  "pnpm@9.15.9",
    "scripts":  {
                    "build":  "turbo run build",
                    "lint":  "turbo run lint",
                    "typecheck":  "turbo run typecheck",
                    "test":  "turbo run test --concurrency=1",
                    "db:migrate":  "pnpm --filter @medos/database migrate",
                    "db:seed":  "pnpm --filter @medos/api seed",
                    "licenses:audit":  "node scripts/license-audit.mjs"
                },
    "devDependencies":  {
                            "turbo":  "^2.3.0",
                            "typescript":  "^5.6.3"
                        },
    "pnpm":  {
                 "overrides":  {
                                   "multer":  "\u003e=2.3.0",
                                   "qs":  "\u003e=6.16.0",
                                   "file-type":  "\u003e=21.3.2",
                                   "body-parser":  "\u003e=1.20.6 \u003c2",
                                   "deepmerge-ts":  "\u003e=8.0.0",
                                   "postcss":  "\u003e=8.5.23"
                               }
             }
}