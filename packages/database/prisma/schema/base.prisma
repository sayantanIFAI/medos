generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Stage 2: tenant / facility ─────────────────────────

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String       @unique
  status    ActiveStatus @default(ACTIVE)
  timezone  String       @default("Asia/Kolkata")
  currency  String       @default("INR")
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  facilities       Facility[]
  users            User[]
  roles            Role[]
  auditEvents      AuditEvent[]
  numberSequences  NumberSequence[]
  numberConfigs    NumberSequenceConfig[]
  departments      Department[]
  practitioners    Practitioner[]
}

model Facility {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String       @db.Uuid
  name       String
  code       String
  address    String?
  city       String?
  district   String?
  state      String?
  postalCode String?
  phone      String?
  email      String?
  gstin      String?
  timezone   String       @default("Asia/Kolkata")
  status     ActiveStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userFacilities  UserFacility[]
  numberSequences NumberSequence[]
  numberConfigs   NumberSequenceConfig[]
  departments     Department[]
  practitioners   Practitioner[]
  patients        Patient[]
  encounters      Encounter[]
  schedules       PractitionerSchedule[]
  appointments    Appointment[]
  queueEntries    QueueEntry[]
  services        Service[]
  invoices        Invoice[]
  cashierShifts   CashierShift[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

// ───────────────────────── Stage 3/4: users, auth, RBAC ─────────────────────────

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String       @db.Uuid
  username          String
  email             String?
  fullName          String
  passwordHash      String
  status            ActiveStatus @default(ACTIVE)
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facilities UserFacility[]
  roles      UserRole[]
  tokens     RefreshToken[]
  practitioners Practitioner[]

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
}

model UserFacility {
  tenantId   String @db.Uuid
  userId     String @db.Uuid
  facilityId String @db.Uuid

  user     User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)

  @@id([userId, facilityId])
  @@index([tenantId, facilityId])
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model RolePermission {
  tenantId   String @db.Uuid
  roleId     String @db.Uuid
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  facilityId   String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([familyId])
}

// ───────────────────────── Audit (append-only; enforced by trigger) ─────────────────────────

model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  facilityId  String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action, createdAt(sort: Desc)])
}

// ───────────────────────── Stage 6: number sequences ─────────────────────────

enum ResetPolicy {
  NEVER
  YEARLY
}

model NumberSequenceConfig {
  tenantId    String      @db.Uuid
  facilityId  String      @db.Uuid
  type        String
  // Tokens: {FACILITY} {YEAR} {SEQ}; e.g. "OPD-{YEAR}-{SEQ}"
  pattern     String
  padding     Int         @default(6)
  resetPolicy ResetPolicy @default(NEVER)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, facilityId, type])
}

model NumberSequence {
  tenantId   String @db.Uuid
  facilityId String @db.Uuid
  type       String
  periodKey  String @default("")
  lastValue  BigInt @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, facilityId, type, periodKey])
}
