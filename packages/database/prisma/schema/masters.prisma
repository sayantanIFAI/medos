// ───────────────────────── Stage 5: hospital masters ─────────────────────────
// Convention: REQUIRED references use composite (tenantId, id) FKs. OPTIONAL references use a
// single-column FK plus the medos_same_tenant trigger (Prisma cannot model optional composite FKs).

model Department {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String       @db.Uuid
  facilityId String       @db.Uuid
  name       String
  code       String
  status     ActiveStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facility      Facility       @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  practitioners Practitioner[]

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, code])
  @@index([tenantId, facilityId, status])
}

model Practitioner {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @db.Uuid
  facilityId     String       @db.Uuid
  userId         String?      @db.Uuid
  departmentId   String?      @db.Uuid
  displayName    String
  specialty      String?
  registrationNo String?
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facility   Facility    @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, facilityId, userId])
  @@index([tenantId, facilityId, status])
  @@index([departmentId])
}
