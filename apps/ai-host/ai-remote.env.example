# Copy to  <repo>\.local\ai-remote.env  (that folder is not committed) and paste the pod's address (http://127.0.0.1:8765 through scripts/ai-tunnel.ps1) and token.
AI_REMOTE_URL=http://127.0.0.1:8765
AI_REMOTE_TOKEN=paste-the-token-from-/workspace/medos-ai/token-on-the-pod
# Optional: a different language model name served by the host's Ollama.
# ASSISTANT_LLM_MODEL=qwen2.5:14b
