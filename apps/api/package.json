{
  "name": "@medos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "pretest": "node scripts/prepare-test-db.mjs && tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"dist-test/**/*.spec.js\"",
    "start": "node dist/main.js",
    "provision": "node dist/cli/provision.js",
    "seed": "node dist/cli/seed.js"
  },
  "dependencies": {
    "@medos/database": "workspace:*",
    "@medos/shared": "workspace:*",
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.14.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
